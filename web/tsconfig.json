{
	"compilerOptions": {
		"sourceMap": true,
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"lib": ["dom", "ES2020"],
		"target": "ES2020",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"types": ["vite/client"],
		"paths": {
			"Interfaces": ["./src/Data/Interfaces", "./src/Data/Interfaces/*"],
			"Components/*": ["./src/Components/*"],
			"Data/*": ["./src/Data/*"],
			"Styles/*": ["./src/Styles/*"],
			"Images/*": ["./src/Images/*"],
			"__tests__/*": ["./__tests__/*"]
		}
	}
}
