{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"react/react-in-jsx-scope": "off"
	},
	"env": {
		"builtin": true,
		"browser": true
	},
	"ignorePatterns": ["dist", "build", "coverage"]
}
