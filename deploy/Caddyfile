# /etc/caddy/Caddyfile — replace YOUR_HOSTNAME (e.g. jordan-santa.duckdns.org).
# Caddy fetches and renews the HTTPS certificate on its own.

YOUR_HOSTNAME {
	encode zstd gzip

	# Security headers: force HTTPS for a year (HSTS), block being framed by other sites
	# (clickjacking), stop MIME sniffing, keep full URLs out of the Referer header, and limit
	# what the page may load (CSP).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Content-Security-Policy: only this site's own scripts run (no inline ones, see
		# web/public/color-scheme.js); styles may be inline (Mantine writes its theme that way)
		# plus Google Fonts; pictures from any https site (shop images); live updates over this
		# host's WebSocket; never framed, no plugins, forms only post here.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' wss://YOUR_HOSTNAME; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Live updates: WebSocket connections go to Reverb, which only listens on 127.0.0.1.
	@reverb path /app /app/*
	handle @reverb {
		reverse_proxy 127.0.0.1:8080
	}

	# Laravel API, Sanctum's CSRF cookie and channel auth, and invite links' page (Laravel
	# sends the React app's page with link-preview tags naming the group).
	@laravel path /api /api/* /sanctum/* /up /join/*
	handle @laravel {
		root * /var/www/secret-santa/api/public
		php_fastcgi unix//run/php/php8.5-fpm.sock
	}

	# Everything else is the built React app; unknown paths fall back to index.html
	# so routes like /wishlist work on refresh.
	handle {
		root * /var/www/secret-santa/web/dist
		@hashedAssets path /assets/*
		header @hashedAssets Cache-Control "public, max-age=31536000, immutable"
		# Everything else (index.html for every route, version.json) must be checked with the
		# server on each load, so a refresh always picks up a new deploy.
		@appShell not path /assets/*
		header @appShell Cache-Control "no-cache"
		# Caddy doesn't know this extension; phones read the manifest to install the app.
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/secret-santa.log
	}
}
