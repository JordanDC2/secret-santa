# /etc/systemd/system/secret-santa-reverb.service
# The WebSocket server for live updates. Listens on 127.0.0.1:8080 (see REVERB_SERVER_HOST);
# Caddy forwards wss://YOUR_HOSTNAME/app to it.
[Unit]
Description=Secret Santa Reverb WebSocket server
After=network-online.target
Wants=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/secret-santa/api
ExecStart=/usr/bin/php artisan reverb:start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
