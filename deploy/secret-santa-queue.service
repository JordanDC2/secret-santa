# /etc/systemd/system/secret-santa-queue.service
# Sends emails and live-update broadcasts. Broadcasts go first so they never wait
# behind an email that's retrying.
[Unit]
Description=Secret Santa queue worker
After=network-online.target
Wants=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/secret-santa/api
ExecStart=/usr/bin/php artisan queue:work --queue=broadcasts,default --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
