# Production api/.env for the Oracle Cloud server. Copy to /var/www/secret-santa/api/.env,
# replace every YOUR_* value, then run `php artisan key:generate`.
# Secrets (APP_KEY, MAIL_PASSWORD, REVERB_APP_SECRET) live only on the server, never in git.

APP_NAME="Secret Santa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_HOSTNAME
FRONTEND_URL=https://YOUR_HOSTNAME
# Gets an email for every new account (leave empty for none).
ADMIN_EMAIL=YOUR_EMAIL_FOR_SIGNUP_ALERTS
ADMIN_TIMEZONE=America/Chicago

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=YOUR_HOSTNAME

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=secretsantamailerclient@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD_NO_SPACES
MAIL_FROM_ADDRESS="secretsantamailerclient@gmail.com"
MAIL_FROM_NAME="Secret Santa"

# Reverb listens privately on the server; Caddy forwards wss://YOUR_HOSTNAME/app to it.
# Generate the three values with: php -r 'echo bin2hex(random_bytes(10)), PHP_EOL;'
REVERB_APP_ID=YOUR_RANDOM_NUMBER
REVERB_APP_KEY=YOUR_RANDOM_KEY
REVERB_APP_SECRET=YOUR_RANDOM_SECRET
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=YOUR_HOSTNAME

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

# Push notifications. Generate the key pair with `php artisan webpush:vapid` (writes both here).
VAPID_SUBJECT="mailto:secretsantamailerclient@gmail.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The browser needs the public key to subscribe (Vite reads VITE_* from this file).
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"
